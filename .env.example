# Choose the dynamic content provider: deepseek or openai.
# If omitted, the server automatically prefers DeepSeek when DEEPSEEK_API_KEY exists.
CONTENT_AI_PROVIDER=deepseek

# DeepSeek configuration. Keep the real key in .env.local and never commit it.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional OpenAI fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
