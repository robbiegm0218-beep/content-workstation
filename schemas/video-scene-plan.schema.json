{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0"},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "subtitle": {"type": "string", "maxLength": 180},
    "sourceMode": {"type": "string", "enum": ["direct-content", "accepted-html"]},
    "aspectRatio": {"type": "string", "enum": ["16:9", "9:16"]},
    "fps": {"type": "integer", "const": 30},
    "width": {"type": "integer", "enum": [1920, 1080]},
    "height": {"type": "integer", "enum": [1080, 1920]},
    "durationInFrames": {"type": "integer", "enum": [900, 9000, 14400]},
    "sourceTrace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "htmlRunId": {"type": "string", "maxLength": 100},
        "htmlSha256": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
        "htmlSections": {"type": "array", "maxItems": 30, "items": {"type": "string", "maxLength": 120}}
      },
      "required": ["htmlRunId", "htmlSha256", "htmlSections"]
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "surface": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "primary": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "accent": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "text": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "muted": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
      },
      "required": ["background", "surface", "primary", "accent", "text", "muted"]
    },
    "materials": {
      "type": "array",
      "maxItems": 120,
      "items": {
        "type": "string",
        "pattern": "^assets/[A-Za-z0-9][A-Za-z0-9._/-]*\\.(png|jpe?g|svg|mp3|wav|mp4)$"
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 120,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^scene-[a-z0-9-]+$"},
          "type": {"type": "string", "enum": ["opening", "statement", "flow", "comparison", "screenshot", "summary"]},
          "startFrame": {"type": "integer", "minimum": 0, "maximum": 14399},
          "durationInFrames": {"type": "integer", "minimum": 30, "maximum": 900},
          "eyebrow": {"type": "string", "maxLength": 40},
          "headline": {"type": "string", "minLength": 1, "maxLength": 80},
          "body": {"type": "string", "maxLength": 180},
          "emphasis": {"type": "array", "maxItems": 4, "items": {"type": "string", "maxLength": 30}},
          "items": {"type": "array", "maxItems": 6, "items": {"type": "string", "maxLength": 60}},
          "narration": {"type": "string", "maxLength": 1200},
          "transition": {"type": "string", "enum": ["none", "fade", "slide", "wipe"]},
          "showCaptions": {"type": "boolean"},
          "materialIds": {"type": "array", "maxItems": 6, "items": {"type": "string", "maxLength": 100}}
        },
        "required": ["id", "type", "startFrame", "durationInFrames", "eyebrow", "headline", "body", "emphasis", "items", "narration", "transition", "showCaptions", "materialIds"]
      }
    },
    "missingMaterials": {
      "type": "array",
      "maxItems": 120,
      "items": {"type": "string", "maxLength": 160}
    },
    "generationMeta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skillName": {"type": "string", "const": "plan-creator-video"},
        "researchUsed": {"type": "boolean", "const": false}
      },
      "required": ["skillName", "researchUsed"]
    }
  },
  "required": ["schemaVersion", "title", "subtitle", "sourceMode", "aspectRatio", "fps", "width", "height", "durationInFrames", "sourceTrace", "theme", "materials", "scenes", "missingMaterials", "generationMeta"]
}
