{
  "name": "content-workstation",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs tests/bridge/*.test.mjs tests/plugin/*.test.mjs",
    "test:ci": "npm run check:privacy && npm run lint && npm test",
    "test:plugin": "node --test tests/plugin/*.test.mjs",
    "test:plugin:codex": "node scripts/smoke-codex-plugin.mjs",
    "test:bridge": "node --test tests/bridge/*.test.mjs",
    "test:codex": "node scripts/smoke-codex-content.mjs",
    "test:codex:html": "node scripts/smoke-codex-artifacts.mjs html",
    "test:codex:cover": "node scripts/smoke-codex-artifacts.mjs cover",
    "test:codex:cancel": "node scripts/smoke-codex-cancel.mjs",
    "test:bridge:codex": "node scripts/smoke-bridge-content.mjs",
    "plugin:validate:skills": "node scripts/validate-content-plugin.mjs --skills-only",
    "plugin:validate": "node scripts/validate-content-plugin.mjs",
    "smoke:codex": "node scripts/smoke-codex-local.mjs",
    "video:install": "npm --prefix video-renderer install",
    "video:browser": "npm --prefix video-renderer run browser:ensure",
    "video:check": "npm --prefix video-renderer run validate:sample && npm --prefix video-renderer test && npm --prefix video-renderer run typecheck",
    "video:studio": "npm --prefix video-renderer run studio",
    "video:render:sample": "npm --prefix video-renderer run render:sample",
    "smoke:video": "node scripts/smoke-video-render.mjs",
    "test:video:render": "node scripts/smoke-video-render.mjs render --yes",
    "check:privacy": "node scripts/check-private-data.mjs",
    "doctor": "node bridge/doctor-cli.mjs",
    "start:bridge": "node bridge/server.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern work --ignore-pattern outputs --ignore-pattern .data",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@remotion/player": "4.0.508",
    "drizzle-orm": "0.45.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-loading-skeleton": "3.5.0",
    "remotion": "4.0.508"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.1",
    "wrangler": "4.120.1"
  },
  "type": "module"
}
